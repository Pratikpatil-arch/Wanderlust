<style>
    .listing-title{
        margin-bottom:1rem;
    }

    #map{
        height:26rem;
        width:100%;
        border-radius:1rem;
    }

    .map-col main{
        height:100%;
    }

    /* Review section: form on the left, reviews grid on the right */
    .review-form-col{
        border-right:1px solid #ebebeb;
        padding-right:2rem;
    }

    .reviews-col{
        padding-left:2rem;
    }

    .review-card{
        margin-bottom:1rem;
    }

    /* Buttons row: space-between for all viewers */
    .btns{
        gap:1rem;
    }

    /* Smaller delete button on review cards (desktop) */
    .review-card .btn-danger{
    font-size:0.8rem;
    margin-bottom:0.15rem;
    margin-left:0.15rem;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    }

    /* Slightly smaller review card content (desktop) */
    .review-card h5{
        font-size:1rem;
         margin-top:0.15rem;
        margin-left:0.15rem;
    }

    .review-card .card-text{
        font-size:0.9rem;
        margin-top:0.15rem;
        margin-left:0.15rem;
    }

    /* Responsiveness for common mobile widths (~360px - 428px) */
    @media (max-width: 576px){
        .listing-title{
            font-size:1.15rem;
            margin-bottom:0.6rem;
        }

        .show-img{
            height:16vh !important;
        }

        .show-card .card-body{
            padding:0.75rem !important;
        }

        .show-card .card-text p{
            font-size:0.82rem;
            margin-bottom:0.35rem;
        }

        #map{
            height:14rem;
        }

        /* Edit/Delete in one row, space-between */
        .btns{
            flex-direction:row;
            margin-top:0.75rem;
        }

        .btns .edit-btn{
            flex:1;
            text-align:center;
            padding:0.4rem;
            font-size:0.85rem;
        }

        .btns form{
            flex:1;
        }

        .btns form button{
            width:100%;
            padding:0.4rem;
            font-size:0.85rem;
        }

        /* Review section stacks, no divider line */
        .review-form-col{
            border-right:none;
            padding-right:0.75rem;
            padding-left:0.75rem;
        }

        .reviews-col{
            padding-left:0.75rem;
            padding-right:0.75rem;
            margin-top:1rem;
        }

        /* Compact review form */
        .review-form-col h4{
            font-size:1.05rem;
        }

        .review-form-col .form-label{
            font-size:0.85rem;
            margin-bottom:0.25rem;
        }

        .review-form-col textarea{
            font-size:0.85rem;
        }

        .starability-slot{
            transform:scale(0.8);
            transform-origin:left center;
        }

        .review-form-col .btn{
            padding:0.4rem 0.9rem;
            font-size:0.85rem;
        }

        .review-card .card-body{
            padding:0.75rem;
        }

        .review-card h5{
            font-size:0.9rem;
        }

        .review-card p{
            font-size:0.82rem;
        }

        .review-card .btn-danger{
            padding:0.2rem 0.6rem;
            font-size:0.75rem;
        }
