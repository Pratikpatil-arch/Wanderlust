<%- layout("/layouts/boilerplate")%>
<style>
   #filters{
    display:flex;
    flex-wrap:wrap;
    align-items: center;
   }

   .filters-scroll{
     display:flex;
     align-items:center;
     flex-wrap:wrap;
   }

   .filter{
     text-align:center;
     margin-right:2rem;
     margin-top:2rem;
     opacity:0.7;
   }
   .filter:hover{
     opacity:1;
     cursor:pointer;
   }
   .filter i{
     font-size:1.1rem;
   }
   .filter p{
     font-size:0.8rem;
   }

   .tax-info{
     display:none;
   }
   .tax-toggle{
     border:1px solid black;
     border-radius:1rem;
     height:3.25rem;
     padding:1rem;
     margin-left:2rem;
     display:flex;
     align-items: center;
   }
   .filter{
    color:#222222;
    text-decoration:none;
}

.filter.active-filter{
    opacity:1;
    color:#ff385c;
    border-bottom:2px solid #ff385c;
}

.filter.active-filter i{
    color:#ff385c;
}

/* Dark toggle instead of Bootstrap's default blue */
.tax-toggle .form-check-input:checked{
    --bs-form-check-input-checked-bg-color:#222222;
    --bs-form-check-input-checked-border-color:#222222;
    background-color:#222222 !important;
    border-color:#222222 !important;
}

/* Only round the top corners so nothing at the bottom (e.g. rating) gets clipped */
.listing-card{
    border-radius:1rem 1rem 0 0;
    overflow:visible;
}

.card-img-top{
    border-radius:1rem 1rem 1rem 1rem !important;
}

.card-img-overlay{
    border-radius:1rem 1rem 0 0;
}

/* Responsiveness for common mobile widths (~360px - 428px) */
@media (max-width: 576px){
    #filters{
        flex-wrap:nowrap;
        align-items:center;
        padding-bottom:0.5rem;
    }

    /* Left half: scrollable filter icons, scrollbar hidden */
    .filters-scroll{
        width:70%;
        flex-shrink:0;
        flex-wrap:nowrap;
        overflow-x:auto;
        overflow-y:hidden;
        scrollbar-width:none;     /* Firefox */
        -ms-overflow-style:none;  /* Edge/IE */
    }

    .filters-scroll::-webkit-scrollbar{
        display:none;             /* Chrome/Safari */
    }

    .filter{
        flex-shrink:0;
        margin-right:0.9rem;
        margin-top:1rem;
    }

    .filter i{
        font-size:0.9rem;
    }

    /* Right half: fixed, non-scrolling tax toggle */
    .tax-toggle{
        width:30%;
        flex-shrink:0;
        margin-left:0.5rem;
        padding:0.5rem 0.6rem;
        height:3rem;
    }

    .tax-toggle .form-check-label{
        font-size:0.5rem;
        line-height:1.1;
    }

    .card-img-top{
        height:6rem !important;
    }

    .card-text{
        font-size:0.7rem;
    }
}
</style>

<% let activeCategory = typeof category !== "undefined" ? category : null; %>
<div id="filters">
   <div class="filters-scroll">
       <a href="/listings?category=trending" class="filter <%= activeCategory==='trending' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
       </a>
        <a href="/listings?category=rooms" class="filter <%= activeCategory==='rooms' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
       </a>
       <a href="/listings?category=iconic-cities" class="filter <%= activeCategory==='iconic-cities' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>iconic cities</p>
       </a>
        <a href="/listings?category=mountains" class="filter <%= activeCategory==='mountains' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
       </a>
       <a href="/listings?category=castles" class="filter <%= activeCategory==='castles' ? 'active-filter' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>castles</p>
       </a>
        <a href="/listings?category=pools" class="filter <%= activeCategory==='pools' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pools</p>
       </a>
       <a href="/listings?category=camping" class="filter <%= activeCategory==='camping' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
       </a>
        <a href="/listings?category=farms" class="filter <%= activeCategory==='farms' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>farms</p>
       </a>
       <a href="/listings?category=arctic" class="filter <%= activeCategory==='arctic' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
        </a>
         <a href="/listings?category=domes" class="filter <%= activeCategory==='domes' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
       </a>
       <a href="/listings?category=boats" class="filter <%= activeCategory==='boats' ? 'active-filter' : '' %>">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
        </a>
   </div>

   <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
   </div>
</div>

<% if (typeof searchQuery !== "undefined" && searchQuery) { %>
<h4 class="mt-3 mb-0">Results for "<%= searchQuery %>"</h4>
<% } %>

<div class="row row-cols-3 row-cols-sm-1 row-cols-md-2 row-cols-lg-5 mt-3">
    <%for(let listing of listings){%>
        <a href="/listings/<%=listing._id%>" class="listing-link">
        <div class="card col listing-card">
            <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height:16rem">
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                   <b><%=listing.title%></b> <br>
                       <%= listing.price ? listing.price.toLocaleString("en-IN") + "/night" : "Price not available" %>
                     <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                </p>
            </div>
        </div>
        </a>
        <%}%>
</div>

<script>
    let taxSwitch = document.querySelector("#switchCheckDefault");

    taxSwitch.addEventListener("click",()=>{
        let taxInfo = document.querySelectorAll(".tax-info");
        for(info of taxInfo){
            if(info.style.display!="inline"){
                  info.style.display="inline";
            } else{
                 info.style.display="none";
            }

        }
    })
</script>