<%- layout("/layouts/boilerplate")%>

<style>
    .form-wrapper{
        display:flex;
        justify-content:center;
        padding:2.5rem 1rem;
    }

    .listing-form-card{
        width:100%;
        max-width:700px;
        background-color:#fff;
        border:1px solid #dddddd;
        border-radius:1.25rem;
        padding:2.5rem 2.5rem;
        box-shadow:0 6px 20px rgba(0,0,0,0.08);
        overflow:hidden;
    }

    /* Full-width hero banner behind the heading */
    .form-hero{
        margin:-2.5rem -2.5rem 2rem -2.5rem;
        height:220px;
        background-image:linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
            url('https://images.pexels.com/photos/7578881/pexels-photo-7578881.jpeg');
        background-size:cover;
        background-position:center;
        display:flex;
        flex-direction:column;
        justify-content:center;
        align-items:center;
        text-align:center;
        padding:1rem;
    }

    .form-hero h2{
        color:#fff;
        margin-bottom:0.4rem;
        font-size:1.7rem;
        font-weight:700;
    }

    .form-hero p{
        color:#f0f0f0;
        margin-bottom:0;
        font-size:0.95rem;
    }

    .listing-form-card .form-label{
        font-weight:600;
        font-size:0.9rem;
        margin-bottom:0.3rem;
    }

    .listing-form-card .form-control,
    .listing-form-card .form-select{
        border-radius:0.6rem;
        padding:0.6rem 0.9rem;
        border:1px solid #b0b0b0;
    }

    .listing-form-card .form-control:focus,
    .listing-form-card .form-select:focus{
        border-color:#ff385c;
        box-shadow:0 0 0 1px #ff385c;
    }

    .listing-form-card textarea.form-control{
        min-height:100px;
    }

    .field-group{
        margin-bottom:1.4rem;
    }

    /* Current image preview */
    .current-image-label{
        font-weight:600;
        font-size:0.9rem;
        margin-bottom:0.5rem;
        color:#222222;
    }

    .current-image-preview{
        width:100%;
        max-width:280px;
        height:170px;
        object-fit:cover;
        border-radius:0.8rem;
        border:1px solid #dddddd;
        display:block;
        margin-bottom:1.4rem;
    }

    /* Cancel + Save row */
    .form-actions{
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-top:0.5rem;
        gap:1rem;
    }

    .cancel-btn{
        background-color:#fff;
        color:#222222;
        border:1px solid #b0b0b0 !important;
        border-radius:0.6rem;
        padding:0.75rem 1.5rem;
        font-weight:600;
        text-decoration:none;
    }

    .cancel-btn:hover{
        color:#f7f7f7;
        background-color:#222222;
    }

    .edit-btn{
        background-color:#ff385c !important;
        color:#fff;
        border:none !important;
        border-radius:0.6rem;
        padding:0.75rem 1.5rem;
        font-weight:600;
    }

    .edit-btn:hover{
        background-color:#e31c5f !important;
        color:#fff;
    }

    /* Responsiveness for common mobile widths (~360px - 428px) */
    @media (max-width: 576px){
        .form-wrapper{
            padding:1rem 0.75rem;
        }

        .listing-form-card{
            max-width:100%;
            padding:1.5rem 1.25rem;
            border-radius:0.85rem;
            box-shadow:0 3px 12px rgba(0,0,0,0.06);
        }

        .form-hero{
            margin:-1.5rem -1.25rem 1.5rem -1.25rem;
            height:140px;
        }

        .form-hero h2{
            font-size:1.25rem;
        }

        .form-hero p{
            font-size:0.8rem;
        }

        .field-group{
            margin-bottom:1rem;
        }

        .listing-form-card .form-label{
            font-size:0.82rem;
        }

        .listing-form-card .form-control,
        .listing-form-card .form-select{
            padding:0.5rem 0.75rem;
            font-size:0.88rem;
        }

        .current-image-preview{
            max-width:100%;
            height:150px;
        }

        .form-actions{
            flex-direction:row;
        }

        .cancel-btn,
        .edit-btn{
            flex:1;
            text-align:center;
            padding:0.6rem;
            font-size:0.88rem;
        }
    }
</style>

<div class="form-wrapper">
    <div class="listing-form-card">
        <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">

            <div class="form-hero">
                <h2>Edit your listing</h2>
                <p>Update the details of your space</p>
            </div>

            <div class="field-group">
                <label for="title" class="form-label">Title</label>
                <input type="text" id="title" class="form-control" value="<%=listing.title%>" name="listing[title]" required>
                <div class="valid-feedback">Title looks good!</div>
                <div class="invalid-feedback">Please enter a title</div>
            </div>

            <div class="field-group">
                <label for="description" class="form-label">Description</label>
                <textarea class="form-control" id="description" name="listing[description]" required><%=listing.description%></textarea>
                <div class="invalid-feedback">Please enter a short description</div>
            </div>

            <div class="field-group">
                <p class="current-image-label">Current image for listing</p>
                <img src="<%=originalImageUrl%>" alt="Current listing image" class="current-image-preview">

                <label for="image" class="form-label">Upload new image</label>
                <input class="form-control" type="file" id="image" name="listing[image][url]">
            </div>

            <div class="row">
                <div class="col-md-4 field-group">
                    <label for="price" class="form-label">Price</label>
                    <input class="form-control" id="price" name="listing[price]" value="<%=listing.price%>" type="number" required>
                    <div class="invalid-feedback">Price should be valid</div>
                </div>

                <div class="col-md-8 field-group">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" class="form-control" id="country" value="<%=listing.country%>" name="listing[country]" required>
                    <div class="invalid-feedback">Please enter the country name</div>
                </div>
            </div>

            <div class="field-group">
                <label for="location" class="form-label">Location</label>
                <input class="form-control" type="text" id="location" value="<%=listing.location%>" name="listing[location]" required>
                <div class="invalid-feedback">Please enter the location</div>
            </div>

            <div class="field-group">
                <label for="category" class="form-label">Category</label>
                <select class="form-select" id="category" name="listing[category]" required>
                    <option value="trending" <%= listing.category === "trending" ? "selected" : "" %>>Trending</option>
                    <option value="rooms" <%= listing.category === "rooms" ? "selected" : "" %>>Rooms</option>
                    <option value="iconic-cities" <%= listing.category === "iconic-cities" ? "selected" : "" %>>Iconic Cities</option>
                    <option value="mountains" <%= listing.category === "mountains" ? "selected" : "" %>>Mountains</option>
                    <option value="castles" <%= listing.category === "castles" ? "selected" : "" %>>Castles</option>
                    <option value="pools" <%= listing.category === "pools" ? "selected" : "" %>>Amazing Pools</option>
                    <option value="camping" <%= listing.category === "camping" ? "selected" : "" %>>Camping</option>
                    <option value="farms" <%= listing.category === "farms" ? "selected" : "" %>>Farms</option>
                    <option value="arctic" <%= listing.category === "arctic" ? "selected" : "" %>>Arctic</option>
                    <option value="domes" <%= listing.category === "domes" ? "selected" : "" %>>Domes</option>
                    <option value="boats" <%= listing.category === "boats" ? "selected" : "" %>>Boats</option>
                </select>
                <div class="invalid-feedback">Please select a category</div>
            </div>

            <div class="form-actions">
                <a href="/listings/<%=listing._id%>" class="btn cancel-btn">Cancel</a>
                <button class="btn edit-btn">Save changes</button>
            </div>
        </form>
    </div>
</div>