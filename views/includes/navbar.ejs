<style>
    .search-btn{
        background-color:#ff385c;
        color:#fff;
        border-radius:25px;
        padding:0 1rem 0 1rem;
    }
     .search-btn:hover{
        background-color:#ff385c;
        color:#fff;
    }
    .search-btn i{
     display:inline;
     margin-right:0.5rem;
    }
    .search-inp {
        border-radius:25px;
        padding:0.5rem 3rem 0.5rem 3rem;
        font-size:1rem;
    }

    /* Mobile-only hamburger toggle, hidden by default */
    .mobile-nav-toggle{
        background:none;
        border:1px solid #dddddd;
        border-radius:0.5rem;
        width:2.6rem;
        height:2.6rem;
        display:none;
        align-items:center;
        justify-content:center;
        cursor:pointer;
    }

    .mobile-nav-toggle i{
        font-size:1.2rem;
        color:#222222;
    }

    /* Backdrop + slide-in panel, hidden by default */
    .nav-backdrop{
        position:fixed;
        inset:0;
        background-color:rgba(0,0,0,0.4);
        opacity:0;
        pointer-events:none;
        transition:opacity 0.3s ease;
        z-index:1040;
        display:none;
    }

    .nav-backdrop.active{
        opacity:1;
        pointer-events:auto;
    }

    .nav-panel{
        position:fixed;
        top:0;
        right:0;
        height:100%;
        width:300px;
        max-width:80vw;
        background-color:#fff;
        box-shadow:-4px 0 20px rgba(0,0,0,0.15);
        transform:translateX(100%);
        transition:transform 0.35s ease;
        z-index:1050;
        padding:1.5rem;
        overflow-y:auto;
        display:none;
    }

    .nav-panel.active{
        transform:translateX(0);
    }

    .nav-panel-header{
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:1.5rem;
    }

    .nav-close-btn{
        background:none;
        border:none;
        font-size:1.4rem;
        color:#222222;
        cursor:pointer;
    }

    .nav-panel .search-inp{
        border-radius:25px;
        padding:0.5rem 1rem;
        font-size:1rem;
        border:1px solid #dddddd;
        width:100%;
        margin-bottom:0.6rem;
    }

    .nav-panel .search-btn{
        background-color:#ff385c;
        color:#fff;
        border-radius:25px;
        border:none;
        padding:0.5rem 1rem;
        width:100%;
    }

    .nav-panel .search-btn:hover{
        background-color:#e31c5f;
        color:#fff;
    }

    .nav-panel-link{
        display:block;
        padding:0.75rem 0;
        color:#222222;
        text-decoration:none;
        border-bottom:1px solid #f0f0f0;
        font-size:1rem;
    }

    .nav-panel-link:hover{
        color:#ff385c;
    }

    .nav-panel-divider{
        margin:1rem 0;
        border:none;
        border-top:1px solid #ebebeb;
    }

    /* Only below lg (~992px): swap desktop row for the mobile toggle + panel */
    @media (max-width: 991.98px){
        .desktop-nav-row{
            display:none !important;
        }

        .mobile-nav-toggle{
            display:flex;
        }

        .nav-backdrop,
        .nav-panel{
            display:block;
        }
    }
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>

        <!-- Mobile-only hamburger; invisible/inert on laptop -->
        <button class="mobile-nav-toggle" type="button" onclick="document.getElementById('navPanel').classList.add('active'); document.getElementById('navBackdrop').classList.add('active');" aria-label="Open menu">
            <i class="fa-solid fa-bars"></i>
        </button>

        <!-- Desktop nav row: identical to your original markup, only hidden below lg -->
        <div class="collapse navbar-collapse show desktop-nav-row">
            <div class="navbar-nav">
                <a class="nav-link" href="/listings">Explore</a>
            </div>
            <div class="navbar-nav ms-auto">
                <form class="d-flex" role="search" action="/listings/search" method="GET">
                    <input class="form-control me-2 search-inp" type="search" name="q" placeholder="Search destinations" autocomplete="off" required/>
                    <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
                </form>
            </div>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/listings/new">Airbnb your home</a>
                <% if(!currUser){%>
                    <a class="nav-link" href="/signup"><b>Sign up</b></a>
                    <a class="nav-link" href="/login"><b>Log in</b></a>
                    <%}%>
                    <%if(currUser){%>
                    <a class="nav-link" href="/logout"><b>Log out</b></a>
                    <%}%>
            </div>
        </div>
    </div>
</nav>

<!-- Mobile-only slide-in panel; display:none on desktop by default -->
<div class="nav-backdrop" id="navBackdrop" onclick="document.getElementById('navPanel').classList.remove('active'); this.classList.remove('active');"></div>

<div class="nav-panel" id="navPanel">
    <div class="nav-panel-header">
        <span><b>Menu</b></span>
        <button class="nav-close-btn" onclick="document.getElementById('navPanel').classList.remove('active'); document.getElementById('navBackdrop').classList.remove('active');" aria-label="Close menu">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <form role="search" action="/listings/search" method="GET" class="mb-3">
        <input class="search-inp" type="search" name="q" placeholder="Search destinations" autocomplete="off" required/>
        <button class="search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
    </form>

    <hr class="nav-panel-divider">

    <a class="nav-panel-link" href="/listings">Explore</a>
    <a class="nav-panel-link" href="/listings/new">Airbnb your home</a>

    <hr class="nav-panel-divider">

    <% if(!currUser){%>
        <a class="nav-panel-link" href="/signup"><b>Sign up</b></a>
        <a class="nav-panel-link" href="/login"><b>Log in</b></a>
        <%}%>
        <%if(currUser){%>
        <a class="nav-panel-link" href="/logout"><b>Log out</b></a>
        <%}%>
</div>