<style>
    .auth-wrapper{
        display:flex;
        justify-content:center;
        padding:3rem 1rem;
    }

    .auth-card{
        width:100%;
        max-width:440px;
        background-color:#fff;
        border:1px solid #dddddd;
        border-radius:1.25rem;
        padding:2.5rem 2rem;
        box-shadow:0 6px 20px rgba(0,0,0,0.08);
    }

    .auth-card h1{
        font-size:1.6rem;
        font-weight:700;
        margin-bottom:0.3rem;
        text-align:center;
    }

    .auth-subtext{
        text-align:center;
        color:#717171;
        margin-bottom:1.8rem;
        font-size:0.95rem;
    }

    .auth-card .form-label{
        font-weight:600;
        font-size:0.9rem;
        margin-bottom:0.3rem;
    }

    .auth-card .form-control{
        border-radius:0.6rem;
        padding:0.6rem 0.9rem;
        border:1px solid #b0b0b0;
    }

    .auth-card .form-control:focus{
        border-color:#ff385c;
        box-shadow:0 0 0 1px #ff385c;
    }

    .auth-btn{
        width:100%;
        background-color:#ff385c;
        color:#fff;
        border:none;
        border-radius:0.6rem;
        padding:0.7rem;
        font-weight:600;
        margin-top:0.5rem;
    }

    .auth-btn:hover{
        background-color:#e31c5f;
        color:#fff;
    }

    .auth-switch{
        text-align:center;
        margin-top:1.2rem;
        font-size:0.9rem;
        color:#222222;
    }

    .auth-switch a{
        color:#ff385c;
        text-decoration:none;
        font-weight:600;
    }

    .auth-switch a:hover{
        text-decoration:underline;
    }

    /* Compact layout for common mobile widths (~360px - 428px) */
    @media (max-width: 576px){
        .auth-wrapper{
            padding:1rem 0.75rem;
            margin-top:2rem;
        }

        .auth-card{
            max-width:100%;
            padding:1.25rem 1rem;
            border-radius:0.85rem;
            box-shadow:0 3px 12px rgba(0,0,0,0.06);
        }

        .auth-card h1{
            font-size:1.15rem;
            margin-bottom:0.2rem;
        }

        .auth-subtext{
            font-size:0.78rem;
            margin-bottom:1rem;
        }

        .auth-card .mb-3{
            margin-bottom:0.65rem !important;
        }

        .auth-card .form-label{
            font-size:0.8rem;
            margin-bottom:0.2rem;
        }

        .auth-card .form-control{
            padding:0.45rem 0.7rem;
            font-size:0.88rem;
            border-radius:0.5rem;
        }

        .auth-btn{
            padding:0.5rem;
            font-size:0.9rem;
            border-radius:0.5rem;
            margin-top:0.3rem;
        }

        .auth-switch{
            font-size:0.8rem;
            margin-top:0.8rem;
        }
    }
</style>
<%- layout("/layouts/boilerplate")%>

<div class="auth-wrapper">
    <div class="auth-card">
        <h1>Sign up on Wanderlust</h1>
        <p class="auth-subtext">Join and start exploring stays around the world</p>

        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" name="username" id="username" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" name="email" id="email" class="form-control" required>
                <div class="valid-feedback">Decent email!</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" id="password" class="form-control" required>
            </div>
            <button class="btn auth-btn">Sign up</button>
        </form>

        <div class="auth-switch">
            Already have an account? <a href="/login">Log in</a>
        </div>
    </div>
</div>